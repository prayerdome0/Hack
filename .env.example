# Firebase web app configuration (safe to expose through NEXT_PUBLIC_ variables).
# These are optional — the app ships with defaults for the seedwel-cbeb8 project.
# Override them when pointing the app at a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Cloudinary uploads ──────────────────────────────────────────────────────
# Recommended: server-side signed uploads. Copy the finished value from
# Cloudinary console → Settings (gear) → API Keys. The API secret stays on the
# server; the browser only ever receives a short-lived upload signature.
CLOUDINARY_URL=

# Optional fallback: unsigned uploads from the browser. Only used when the
# server has no CLOUDINARY_URL. Requires an unsigned upload preset in the
# Cloudinary dashboard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Optional: required only for server-side Firestore writes such as play counts.
# It is NOT required for media uploads.
# FIREBASE_SERVICE_ACCOUNT_JSON=
