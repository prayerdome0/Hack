rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // A new account can create its own user profile, but can never choose admin.
      allow create: if isSelf(uid) && request.resource.data.role == 'user';
      allow update: if isAdmin() || (isSelf(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /artists/{artistId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /albums/{albumId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /playlists/{playlistId} {
      allow read: if resource.data.isPublic == true || (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isAdmin() || (signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.isPublic == false);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid && request.resource.data.isPublic == false);
    }
    match /favorites/{favoriteId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && favoriteId == request.auth.uid + '_' + request.resource.data.songId;
      allow update: if false;
    }
    match /recentlyPlayed/{playId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid && playId == request.auth.uid + '_' + request.resource.data.songId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
